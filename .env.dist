# Copy to .env and fill in. .env is git-ignored.

# Snowflake
AIRFLOW_CONN_SNOWFLAKE_ASTROTRIPS='{"conn_type":"snowflake","login":"YOUR_USER","schema":"PUBLIC","extra":{"account":"YOUR_ACCOUNT","warehouse":"YOUR_WH","database":"ASTROTRIPS","role":"YOUR_ROLE","authenticator":"snowflake","application":"AIRFLOW","private_key_content":"BASE64_PRIVATE_KEY"}}'

# LLM connection for every Common AI decorator (API key in password, model in extra.model).
AIRFLOW_CONN_PYDANTICAI_DEFAULT='{"conn_type":"pydanticai","password":"YOUR_OPENAI_API_KEY","extra":{"model":"openai:gpt-5-mini"}}'

# Durable execution cache for @task.agent(durable=True) in dags/02.
AIRFLOW__COMMON_AI__DURABLE_CACHE_PATH=file:///usr/local/airflow/include/durable_cache

# OpenTelemetry tracing settings live in .env.traces

# Token Console plugin: how it reaches the Airflow REST API.
# Local Astro: admin/admin. Astro production: set TOKEN_CONSOLE_TOKEN instead.
TOKEN_CONSOLE_HOST=http://localhost:8080
TOKEN_CONSOLE_USERNAME=admin
TOKEN_CONSOLE_PASSWORD=admin
# TOKEN_CONSOLE_TOKEN=your-astro-deployment-api-token
