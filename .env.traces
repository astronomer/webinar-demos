# Opt-in OpenTelemetry tracing for the Common AI provider.

# Core tracing. This installs the SDK TracerProvider in the scheduler and, the part
# that actually matters here, in the task-runner process: the provider reuses that
# provider and emits nothing without it.
AIRFLOW__TRACES__OTEL_ON=True

# Attach pydantic-ai's GenAI instrumentation to every agent the provider builds.
# Covers @task.llm, @task.llm_sql and @task.agent, since all three go through
# PydanticAIHook.create_agent.
AIRFLOW__COMMON_AI__OTEL_EXPORT_ENABLED=True

# Demo only. Exports prompt and completion text to the collector unredacted:
# Airflow secret masking covers logs and rendered templates, not span attributes.
# Set to False before showing this to anyone with real data.
AIRFLOW__COMMON_AI__CAPTURE_CONTENT=True

# Where the spans go. The viewer runs on the host, containers reach it through
# host.docker.internal. An http:// scheme means an insecure gRPC channel, so the
# default OTLP/gRPC exporter needs no further flags.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_SERVICE_NAME=astrotrips-airflow

# The task runner force-flushes spans when the task process exits. The default
# budget is 30s, which is also how long every task would hang if the viewer is not
# running. 5s keeps a forgotten viewer from wrecking the demo timing.
AIRFLOW__TRACES__TASK_RUNNER_FLUSH_TIMEOUT_MILLISECONDS=5000

# Scheduler-side spans batch on a 5s timer by default. Shorten it so the Dag-run
# span shows up in the viewer while you are still talking about it.
OTEL_BSP_SCHEDULE_DELAY=1000
