# Demo settings. No secrets in here.

# Dags start unpaused so asset-triggered runs appear right away.
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
# Pick up ./demo.sh use <version> within seconds instead of the 300s / 30s defaults.
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=5
AIRFLOW__DAG_PROCESSOR__MIN_FILE_PROCESS_INTERVAL=5

# Second demo: when the triggerer starts, wait 5 seconds before the shared Kafka consumer polls, so every
# watcher on the topic has subscribed before the first message is handed out. The default (0)
# can hand early messages to the first watcher only.
AIRFLOW__TRIGGERER__SHARED_STREAM_COHORT_GRACE_PERIOD=5
