# Demo settings. No secrets in here: the LLM key comes from OPENAI_API_KEY in your shell
# (see docker-compose.override.yml).

# Dags start unpaused so asset-triggered runs appear right away.
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
# Pick up ./demo.sh use <version> within seconds instead of the 300s / 30s defaults.
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=5
AIRFLOW__DAG_PROCESSOR__MIN_FILE_PROCESS_INTERVAL=5

# >>> xcom-backend: ./demo.sh use v3|v4|v5 copies versions/v3/xcom_backend.env here, v1|v2 empty it.
# v3: XCom values over 1 MB go to the xcom bucket in MinIO, not Airflow's metadata database.
# The compression must be a codec name ("gzip"), not a file suffix ("gz").
AIRFLOW__CORE__XCOM_BACKEND=airflow.providers.common.io.xcom.backend.XComObjectStorageBackend
AIRFLOW__COMMON_IO__XCOM_OBJECTSTORAGE_PATH=s3://minio@xcom/xcom
AIRFLOW__COMMON_IO__XCOM_OBJECTSTORAGE_THRESHOLD=1048576
AIRFLOW__COMMON_IO__XCOM_OBJECTSTORAGE_COMPRESSION=gzip
# <<< xcom-backend
